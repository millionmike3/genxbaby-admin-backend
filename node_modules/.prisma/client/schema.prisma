datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Pillar {
  PROOF_OF_FUNDS
  DEAL_PROSPECTING
  CERTIFIED_CHECK
  MORTGAGE_LOS
  CRM
  DIALER
  MESSAGING
  EMAIL
  STOCK_SANITIZER
  LENDING_SANITIZER
  PRODUCTIVITY_SANITIZER

  BLOCKCHAIN_AUDIT
  SMART_CONTRACT_VERIFICATION
  AUDIT_EXPLORER

  AI_UNDERWRITING
  AI_DEAL_ANALYZER
  AI_AUDIT_ASSISTANT

  BEHAVIORAL_RISK_ENGINE
  CUSTOMER_BEHAVIOR
  INVESTOR_BEHAVIOR
  LEAD_BEHAVIOR

  PRICING_ENGINE
  MARKET_RISK_ENGINE
}

enum UserRole {
  ADMIN
  OWNER
  UNDERWRITER
  INVESTOR
  LOAN_OFFICER
  PROCESSOR
  SERVICING
  STAFF
  BORROWER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum InvestorAction {
  QUOTE_REQUEST
  LOGIN
  VIEWED_DASHBOARD
}

// ------------------------------------------------------------
// USER + AUTH DOMAIN
// ------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String?
  phone        String?
  passwordHash String?
  role         UserRole @default(BORROWER)

  walletAddress String?
  ownerId       String?
  xp            Int      @default(0)
  createdAt     DateTime @default(now())

  owner Owner?

  positions        Position[]
  auditLogs        AuditLog[]
  audits           Audit[]
  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
  bluetoothEvents  BluetoothEvent[]
  investors        Investor[]
  investorScores   InvestorScoringResult[]
  leads            Lead[]
  leadScores       LeadScoringResult[]
  fraudEvents      FraudEvent[]
  fraudScores      FraudScore[]
  FraudPipeline    FraudPipeline[]

  fraudSignals             FraudSignal[]
  FraudCaseHistory         FraudCaseHistory[]
  FraudFlag                FraudFlag[]
  scoreRecords             ScoreRecord[]
  SuspiciousActivityReport SuspiciousActivityReport[]
  BehavioralScoringLayer   BehavioralScoringLayer[]
  BehavioralTrendAnalytics BehavioralTrendAnalytics[]
  bluetoothAlerts          BluetoothAlert[]
  bluetoothRiskEvents      BluetoothRiskEvent[]
  OwnershipEntity          OwnershipEntity[]
  UserRiskScore            UserRiskScore?
  UserRiskSignal           UserRiskSignal?
  sessions                 Session[]
}

// ------------------------------------------------------------
// BORROWER DOMAIN
// ------------------------------------------------------------

model Borrower {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // --- Core Identity Fields (required for 1003) ---
  firstName      String
  middleName     String?
  lastName       String
  fullName       String? // you already had this, keep it optional
  ssn            String // encrypted at application layer
  dob            DateTime
  citizenship    String?
  phone          String?
  email          String                  @unique
  employer       String?
  userId         Int?                    @unique
  riskScore      BorrowerRiskScore?
  behaviorScore  BorrowerBehaviorScore?
  financialScore BorrowerFinancialScore?

  applications                Application[]
  BorrowerBehavioralRiskLayer BorrowerBehavioralRiskLayer[]
  BorrowerBehavioralDrift     BorrowerBehavioralDrift[]
  BorrowerRepaymentResilience BorrowerRepaymentResilience[]
  BorrowerRetentionAnalytics  BorrowerRetentionAnalytics[]
  BorrowerHardshipAnalytics   BorrowerHardshipAnalytics[]
  BorrowerFinancialStability  BorrowerFinancialStability[]
  BorrowerFinancialDrift      BorrowerFinancialDrift[]
  BorrowerMacroRiskExposure   BorrowerMacroRiskExposure[]

  MortgageAsset MortgageAsset[]

  borrowerProfiles     BorrowerProfile[]
  borrowerEmployment   BorrowerEmployment[]
  borrowerIncome       BorrowerIncome[]
  borrowerAssets       BorrowerAssets[]
  borrowerLiabilities  BorrowerLiabilities[]
  borrowerProperty     BorrowerProperty[]
  borrowerDeclarations BorrowerDeclarations[]
  borrowerDemographics BorrowerDemographics[]
  borrowerDocuments    BorrowerDocument[]
  tasks                Task[]
}

// ------------------------------------------------------------
// INVESTOR DOMAIN
// ------------------------------------------------------------

model Investor {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String?
  phone                  String?
  userId                 Int?
  user                   User?                   @relation(fields: [userId], references: [id])
  pricingSheet           InvestorPricingSheet?   @relation("InvestorPricingSheetRelation")
  InvestorRiskScore      InvestorRiskScore?      @relation("PrimaryInvestorRiskScoreRelation")
  InvestorBehaviorScore  InvestorBehaviorScore?  @relation("PrimaryInvestorBehaviorScoreRelation")
  InvestorLiquidityScore InvestorLiquidityScore? @relation("PrimaryInvestorLiquidityScoreRelation")
  riskScore              InvestorRiskScore?      @relation("SecondaryInvestorRiskScoreRelation")
  behaviorScore          InvestorBehaviorScore?  @relation("SecondaryInvestorBehaviorScoreRelation")
  liquidityScore         InvestorLiquidityScore? @relation("SecondaryInvestorLiquidityScoreRelation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investorPotentialScore Int    @default(0)
  investorPotentialBand  String @default("low")

  notes                            String?
  behaviors                        InvestorBehavior[]
  behaviorProfiles                 BehaviorProfile[]
  behaviorEvents                   BehaviorEvent[]
  scoringResults                   InvestorScoringResult[]
  InvestorLiquidity                InvestorLiquidity[]
  InvestorPerformanceSnapshot      InvestorPerformanceSnapshot[]
  InvestorRiskBandHistory          InvestorRiskBandHistory[]
  InvestorCapitalFlow              InvestorCapitalFlow[]
  InvestorAllocationDynamics       InvestorAllocationDynamics[]
  InvestorDiversificationAnalytics InvestorDiversificationAnalytics[]
  pipelineDeals                    PipelineDeal[]
  fundingRequests                  FundingRequest[]
  documentApprovals                DocumentApproval[]
  onboarding                       InvestorOnboarding[]
  fraudReviews                     FraudReview[]
  portfolioAdjustments             PortfolioAdjustment[]
  investments                      Investment[]
  commitments                      Commitment[]
}

model InvestorBehavior {
  id         String   @id @default(uuid())
  investorId String
  timestamp  DateTime @default(now())
  notes      String?
  action     String
  metadata   Json?

  investor Investor @relation(fields: [investorId], references: [id])
}

// ------------------------------------------------------------
// LEADS
// ------------------------------------------------------------

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  scores    Json?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  contactAttempts  ContactAttempt[]
  leadEvents       LeadEvent[]
  behaviorProfiles BehaviorProfile[]
  behaviorEvents   BehaviorEvent[]
  BluetoothEvent   BluetoothEvent[]
  scoringResults   LeadScoringResult[]
  tasks            Task[]
}

model LeadEvent {
  id             String   @id @default(uuid())
  leadId         String
  eventType      String
  page           String?
  element        String?
  description    String?
  timestamp      DateTime @default(now())
  responseTimeMs Int?
  lateNight      Boolean?
  metadata       Json?
  createdAt      DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

model ContactAttempt {
  id        String   @id @default(uuid())
  leadId    String
  timestamp DateTime @default(now())
  notes     String?
  channel   String?
  outcome   String?

  lead Lead @relation(fields: [leadId], references: [id])
}

// ------------------------------------------------------------
// AUDIT + LOGGING
// ------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  target    String?
  details   String?
  adminId   Int?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [adminId], references: [id])
}

model Audit {
  id        String   @id @default(uuid())
  action    String
  details   Json
  createdAt DateTime @default(now())

  adminId Int?
  admin   User? @relation(fields: [adminId], references: [id])
}

// ------------------------------------------------------------
// POSITIONS
// ------------------------------------------------------------

model Position {
  id         Int      @id @default(autoincrement())
  investorId Int
  note       String
  amount     Int
  yield      String
  createdAt  DateTime @default(now())

  investor User @relation(fields: [investorId], references: [id])
}

// ------------------------------------------------------------
// ENVIRONMENT READING
// ------------------------------------------------------------

model EnvironmentReading {
  id               String   @id @default(uuid())
  locationId       String
  deviceCount      Int
  bluetoothDensity Int
  timestamp        DateTime
  riskScore        Float
  createdAt        DateTime @default(now())

  age              Int?
  incomeVolatility Float?
  ipReputation     String?
}

// ------------------------------------------------------------
// APPLICATION (Core Loan File)
// ------------------------------------------------------------

model Application {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  borrowerId String?
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])

  // Core mortgage / loan fields (1003)
  loanAmount      Int? // or Float? if you prefer
  loanPurpose     String?
  propertyAddress String?
  propertyCity    String?
  propertyState   String?
  propertyZip     String?
  propertyCounty  String?
  units           Int?
  occupancy       String?
  propertyType    String?

  // Existing fields
  employer           String?
  underwritingStatus String?
  noteRate           Float?
  liquidAssets       Int?
  loanOfficerId      String?
  loanOfficer        LoanOfficer? @relation(fields: [loanOfficerId], references: [id])
  milestone          String       @default("Application Submitted")
  status             String       @default("SUBMITTED") // changed from "draft" to match submit route
  loanType           String?
  behaviorScore      Float?
  fraudScore         Float?
  routingScore       Float?

  purchasePrice     Int?
  incomeAnnual      Int?
  assetsLiquid      Int?
  underwritingScore Int?

  incomeMonthly Int?
  debtsMonthly  Int?
  pitiMonthly   Int?
  propertyValue Int?
  totalLiens    Int?

  // Full 1003 payload for audit / replay
  full1003Json Json?

  timelineEvents TimelineEvent[]
  timeline       Timeline[]
  documents      Document[]
  disclosures    Disclosure[]
  underwriting   UnderwritingCase?
  fraudEvents    FraudEvent[]
  milestones     ApplicationMilestone[]

  scoringPipelines     ApplicationScoringPipeline[]
  workflowLayers       ApplicationWorkflowAiLayer[]
  aiScoring            ApplicationAiScoring[]
  riskLadders          ApplicationRiskLadder[]
  complianceLadders    ApplicationComplianceLadder[]
  fraudLadders         ApplicationFraudRiskLadder[]
  complianceChains     ApplicationComplianceSignalChain[]
  fraudChains          ApplicationFraudSignalChain[]
  documentCompleteness ApplicationDocumentCompleteness[]

  amortization LoanAmortization?
  payoff       LoanPayoff?
  delinquency  LoanDelinquency?

  FraudAiInferenceLog          FraudAiInferenceLog?
  FraudEscalation              FraudEscalation?
  FraudEscalationPipelineLayer FraudEscalationPipelineLayer?
  FraudAnomalyDetection        FraudAnomalyDetection?
  FraudFeatureStore            FraudFeatureStore?
  FraudCluster                 FraudCluster?
  FraudTrajectoryModel         FraudTrajectoryModel?
  FraudPropagationModel        FraudPropagationModel?
  FraudContagionMapping        FraudContagionMapping?
  FraudTemporalEvolution       FraudTemporalEvolution?
  FraudNetworkMapping          FraudNetworkMapping?
  FraudPatternEvolution        FraudPatternEvolution?
  FraudSignalChain             FraudSignalChain?
  PricingEngineAudit           PricingEngineAudit?
  PricingEngineInferenceLog    PricingEngineInferenceLog?
  PricingComponentScoring      PricingComponentScoring?
  PricingOptimizationLayer     PricingOptimizationLayer?
  PricingSensitivityLayer      PricingSensitivityLayer?
  PricingAnomalyDetection      PricingAnomalyDetection?
  PricingCurveFitting          PricingCurveFitting?
  PricingVolatilityTracking    PricingVolatilityTracking?
  PricingElasticityAnalytics   PricingElasticityAnalytics?
  LoanRestructuringAnalytics   LoanRestructuringAnalytics?
  LoanCovenantTracking         LoanCovenantTracking?
  LoanCovenantStress           LoanCovenantStress?
  LoanPerformanceTrajectory    LoanPerformanceTrajectory?
  LoanRepaymentCurve           LoanRepaymentCurve?
  LoanStressTest               LoanStressTest?
  Check                        Check?
  PricingScenario              PricingScenario?
  PricingResult                PricingResult?

  FraudResult        FraudResult?
  FraudSignalOutput  FraudSignalOutput?
  FraudAnomalyOutput FraudAnomalyOutput?

  CovenantBreach       CovenantBreach?
  CovenantStressResult CovenantStressResult?
  StressTestScenario   StressTestScenario?
  StressTestResult     StressTestResult?

  ScoringResult        ScoringResult?
  AnchorRecord         AnchorRecord?
  pipelineDeals        PipelineDeal[]
  scoreRecords         ScoreRecord[]
  borrowerProfiles     BorrowerProfile[]
  borrowerEmployment   BorrowerEmployment[]
  borrowerIncome       BorrowerIncome[]
  borrowerAssets       BorrowerAssets[]
  borrowerLiabilities  BorrowerLiabilities[]
  borrowerProperty     BorrowerProperty[]
  borrowerDeclarations BorrowerDeclarations[]
  borrowerDemographics BorrowerDemographics[]
  underwriterDecisions UnderwriterDecision[]
  BorrowerDocument     BorrowerDocument[]
  documentRequirements DocumentRequirement[]
  pipelineOutput       UnderwritingPipelineOutput? @relation(fields: [underwritingPipelineOutputId], references: [id])

  underwritingAudit UnderwritingAudit[]

  servicingRecord     ServicingRecord?
  loanServicingEvents LoanServicingEvent[]
  servicingEventScore ServicingEventScore?
  servicingRiskSignal ServicingRiskSignal?

  underwritingPipelineOutputId String?
}

// ------------------------------------------------------------
// TIMELINE
// ------------------------------------------------------------

model TimelineEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  message   String?

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type     String
  metadata Json?
}

model Timeline {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type      String?
  message   String?
  event     String
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// APPLICATION MILESTONES
// ------------------------------------------------------------

model ApplicationMilestone {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  milestone String?
  timestamp DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ------------------------------------------------------------
// DOCUMENT (Core)
// ------------------------------------------------------------

model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type         String
  url          String
  fraudScore   Float?
  fraudSignals Json?
  embedColor   String?

  classifications     DocumentClassification[]
  ocrExtractions      DocumentOcrExtraction[]
  versions            DocumentVersion[]
  lineage             DocumentLineage?
  complianceScore     DocumentComplianceScore?
  semantic            DocumentSemanticExtraction?
  structural          DocumentStructuralAnalysis?
  transformations     DocumentTransformationLog[]
  extractionPipelines DocumentExtractionPipeline[]
  aiLayers            DocumentAiClassificationLayer[]

  embeddings     DocumentEmbedding[]
  semanticScores DocumentSemanticScore[]
  riskSignals    DocumentRiskSignal[]
  approvals      DocumentApproval[]
}

// ------------------------------------------------------------
// DOCUMENT SUBMODELS
// ------------------------------------------------------------

model DocumentClassification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  category   String?
  confidence Float?
  metadata   Json?
}

model DocumentOcrExtraction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  text       String?
  fields     Json?
  confidence Float?
  metadata   Json?
}

model DocumentVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  version  Int?
  url      String?
  metadata Json?
}

model DocumentLineage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  lineage  Json?
  version  Int?
  metadata Json?
}

model DocumentSemanticExtraction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id])

  semantics  Json?
  confidence Float?
  metadata   Json?
}

model DocumentStructuralAnalysis {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String    @unique
  document   Document? @relation(fields: [documentId], references: [id])

  structure Json?
  anomalies Json?
  metadata  Json?
}

model DocumentExtractionPipeline {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String    @unique
  document   Document? @relation(fields: [documentId], references: [id])

  pipelineName String?
  steps        Json?
  metadata     Json?
}

// ------------------------------------------------------------
// DOCUMENT AI OUTPUT MODELS (TS-Referenced)
// ------------------------------------------------------------

model DocumentEmbedding {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  vector   Json?
  metadata Json?
}

model DocumentSemanticScore {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  score    Float?
  metadata Json?
}

model DocumentRiskSignal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  signalType String?
  strength   Float?
  metadata   Json?
}

// ------------------------------------------------------------
// DISCLOSURE (Core)
// ------------------------------------------------------------

model Disclosure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])

  type    String
  url     String?
  title   String?
  content String?

  complianceRecords  DisclosureCompliance[]
  trackingRecords    DisclosureTracking[]
  auditTrail         DisclosureAuditTrail[]
  snapshots          DisclosureComplianceSnapshot[]
  lifecycle          DisclosureLifecycleAnalytics?
  complianceLayers   DisclosureComplianceLayer[]
  behaviorAnalytics  DisclosureBehaviorAnalytics?
  behaviorTrajectory DisclosureBehaviorTrajectory?
  sentiment          DisclosureSentimentAnalytics?
  engagement         DisclosureEngagementAnalytics?
}

// ------------------------------------------------------------
// DISCLOSURE SUBMODELS
// ------------------------------------------------------------

model DisclosureCompliance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  compliant Boolean?
  issues    Json?
  metadata  Json?
}

model DisclosureTracking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  viewedAt   DateTime?
  acceptedAt DateTime?
  metadata   Json?
}

model DisclosureAuditTrail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  eventType String?
  timestamp DateTime?
  metadata  Json?
}

model DisclosureComplianceSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String?
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  compliant Boolean?
  issues    Json?
  metadata  Json?
}

model DisclosureLifecycleAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  lifecycleStage String?
  metrics        Json?
  metadata       Json?
}

model DisclosureComplianceLayer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  layerName       String?
  complianceScore Float?
  issues          Json?
  metadata        Json?
}

model DisclosureBehaviorAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  behaviorScore Float?
  patterns      Json?
  metadata      Json?
}

model DisclosureBehaviorTrajectory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  trajectory    Json?
  behaviorScore Float?
  metadata      Json?
}

model DisclosureSentimentAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  sentiment String?
  score     Float?
  metadata  Json?
}

model DisclosureEngagementAnalytics {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disclosureId String      @unique
  disclosure   Disclosure? @relation(fields: [disclosureId], references: [id])

  engagementScore Float?
  interactions    Json?
  metadata        Json?
}

// ------------------------------------------------------------
// UNDERWRITING CASE (Master Underwriting File)
// ------------------------------------------------------------

model UnderwritingCase {
  id            String      @id @unique @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  dti            Float?
  ltv            Float?
  cltv           Float?
  reservesMonths Float?
  riskScore      Float?
  fraudScore     Float?
  routingScore   Float? // NEW

  investorDecision String?
  llpa             Float?
  finalRate        Float?
  reasons          Json?
  investorReasons  Json?

  status String // PENDING, IN_REVIEW, APPROVED, REFER, DECLINED
  notes  String?

  ausFinding String? // Approve/Eligible, Refer/Eligible, Refer with Caution, Ineligible
  decision   String? // APPROVE, REFER, DECLINE, COUNTER
  conditions String? // JSON or text blob of conditions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  underwritingEvents UnderwritingEvent[]
  steps              UnderwritingStep[]
  decisions          UnderwritingDecision[]
  rules              UnderwritingRule[]
  ruleEvaluations    UnderwritingRuleEvaluation[]
  automations        UnderwritingAutomation[]
  exceptions         UnderwritingExceptionLog[]
  escalations        UnderwritingExceptionEscalation[]
  snapshots          UnderwritingSnapshot[]
  aiDecisions        UnderwritingAiDecisionLog[]
  ruleChains         UnderwritingRuleChain[]
  chainAnalytics     UnderwritingChainAnalytics[]
  overrides          UnderwritingOverrideLog[]
  probabilistic      UnderwritingProbabilisticScoring?
  decisionTree       UnderwritingDecisionTree?
  calibrationLogs    UnderwritingCalibrationLog[]

  scoreResults    UnderwritingScoreResult[]
  pipelineOutputs UnderwritingPipelineOutput[]
  riskFactors     UnderwritingRiskFactors[]
  decisionOutputs UnderwritingDecisionOutput[]
  fraudReviews    FraudReview[]
}

// ------------------------------------------------------------
// UNDERWRITING EVENT
// ------------------------------------------------------------

model UnderwritingEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  underwritingCaseId String?
  underwritingCase   UnderwritingCase? @relation(fields: [underwritingCaseId], references: [id])

  eventType String?
  payload   Json?
}

// ------------------------------------------------------------
// UNDERWRITING STEP
// ------------------------------------------------------------

model UnderwritingStep {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  underwritingCaseId String?
  underwritingCase   UnderwritingCase? @relation(fields: [underwritingCaseId], references: [id])

  stepName String?
  status   String?
  notes    String?
  metadata Json?
}

// ------------------------------------------------------------
// UNDERWRITING DECISION
// ------------------------------------------------------------

model UnderwritingDecision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  underwritingCaseId String?
  underwritingCase   UnderwritingCase? @relation(fields: [underwritingCaseId], references: [id])

  decision String?
  reason   String?
  metadata Json?
}

// ------------------------------------------------------------
// UNDERWRITING RULE
