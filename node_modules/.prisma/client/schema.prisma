  occupancy   String // "owner", "nonowner"
  ficoMin     Int
  ficoMax     Int
  ltvMin      Float
  ltvMax      Float
  termMonths  Int
  llpaBps     Int
  createdAt   DateTime @default(now())
}

model UnderwritingAssetSnapshot {
  id                    Int      @id @default(autoincrement())
  ownerId               Int
  propertyId            Int
  mortgageAssetId       Int?
  assetQualityScore     Int
  cashflowScore         Int
  riskScore             Int
  diversificationImpact Int
  valuationJson         Json
  createdAt             DateTime @default(now())
}

model RiskSnapshot {
  id              Int      @id @default(autoincrement())
  loanId          Int
  ltv             Float
  dscr            Float
  riskScore       Int
  delinquencyJson Json
  marketJson      Json
  createdAt       DateTime @default(now())
}

model BorrowerProfile {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  firstName     String
  middleInitial String?
  lastName      String
  suffix        String?

  dob DateTime
  ssn String // encrypted at the application layer

  phone String?
  email String?

  address        String
  city           String
  state          String
  zip            String
  yearsAtAddress Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerEmployment {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  employerName      String
  jobTitle          String?
  employmentType    String? // W2, 1099, Self-Employed, Retired, etc.
  startDate         DateTime?
  yearsInProfession Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerIncome {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  w2IncomeAnnual  Int?
  w2IncomeMonthly Int?

  contractorIncomeAnnual  Int?
  contractorIncomeMonthly Int?

  selfEmploymentIncomeAnnual  Int?
  selfEmploymentIncomeMonthly Int?

  otherIncomeAnnual  Int?
  otherIncomeMonthly Int?

  totalIncomeMonthly Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerAssets {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  checkingBalance   Int?
  savingsBalance    Int?
  cashOnHand        Int?
  retirementBalance Int?
  investmentBalance Int?
  otherAssets       Int?

  totalAssets Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerLiabilities {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  creditCardPayments   Int?
  autoLoanPayments     Int?
  studentLoanPayments  Int?
  personalLoanPayments Int?
  collectionsPayments  Int?
  otherDebtPayments    Int?

  totalMonthlyDebt Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerProperty {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  propertyAddress String
  propertyCity    String
  propertyState   String
  propertyZip     String

  occupancyType String? // Primary, Secondary, Investment
  propertyType  String? // Single Family, Condo, Multi-Family, etc.

  purchasePrice     Int?
  estimatedValue    Int?
  loanAmount        Int?
  downPayment       Int?
  downPaymentSource String? // Savings, Gift, Sale of Home, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerDeclarations {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  // Standard 1003 declaration questions
  bankruptcy            Boolean?
  foreclosure           Boolean?
  judgments             Boolean?
  delinquentFederalDebt Boolean?
  alimonyChildSupport   Boolean?
  coMakerEndorser       Boolean?
  ownershipInterest     Boolean?
  outstandingLiens      Boolean?
  citizenshipStatus     String? // US Citizen, Permanent Resident, Non‑Resident
  militaryService       Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model BorrowerDemographics {
  id            String @id @default(cuid())
  borrowerId    String
  applicationId String

  ethnicity String? // Hispanic/Latino, Not Hispanic/Latino, Decline
  race      String? // White, Black, Asian, Native American, Pacific Islander, Decline
  sex       String? // Male, Female, Decline

  collectionMethod String? // Visual Observation, Self-Reported

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrower    Borrower    @relation(fields: [borrowerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
}

model UnderwriterDecision {
  id             String   @id @default(cuid())
  underwriterId  String
  applicationId  String
  decision       String // approved, denied, returned, conditions
  decisionTimeMs Int
  finalOutcome   String? // if later overridden
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

model FundingRequest {
  id         String   @id @default(uuid())
  investorId String
  amount     Float
  type       String // "CONTRIBUTION" or "WITHDRAWAL"
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])

  @@index([investorId])
}

model AdminMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model DocumentApproval {
  id         String   @id @default(uuid())
  investorId String
  documentId String
  status     String   @default("PENDING") // APPROVED | REJECTED
  notes      String?
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
  document Document @relation(fields: [documentId], references: [id])
}

model InvestorOnboarding {
  id         String   @id @default(uuid())
  investorId String
  status     String   @default("PENDING") // APPROVED | REJECTED
  notes      String?
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
}

model AdminNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  createdAt DateTime @default(now())
}

model FraudReview {
  id         String   @id @default(uuid())
  investorId String
  caseId     String
  riskScore  Float
  status     String   @default("OPEN") // OPEN | REVIEWED | ESCALATED
  createdAt  DateTime @default(now())

  investor Investor         @relation(fields: [investorId], references: [id])
  case     UnderwritingCase @relation(fields: [caseId], references: [id])
}

model PortfolioAdjustment {
  id         String   @id @default(uuid())
  investorId String
  assetClass String
  oldValue   Float
  newValue   Float
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
}

model Deal {
  id        Int      @id @default(autoincrement())
  name      String
  summary   String?
  createdAt DateTime @default(now())

  investments Investment[]
}

model Investment {
  id         String   @id @default(uuid())
  investorId String
  dealId     Int
  amount     Float
  status     String
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
  deal     Deal     @relation(fields: [dealId], references: [id])
}

model Commitment {
  id         Int      @id @default(autoincrement())
  investorId String
  amount     Float
  status     String
  createdAt  DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id])
}

model BorrowerDocument {
  id            String   @id @default(cuid())
  borrowerId    String
  applicationId String?
  type          String
  fileUrl       String
  status        String   @default("uploaded")
  notes         String?
  uploadedAt    DateTime @default(now())

  borrower    Borrower     @relation(fields: [borrowerId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])
}

model Owner {
  id     String @id @default(cuid())
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])

  email    String?
  fullName String?

  properties     Property[]
  mortgageAssets MortgageAsset[]
}

model Tenant {
  id         String   @id @default(cuid())
  propertyId Int
  fullName   String
  email      String
  rentAmount Float
  createdAt  DateTime @default(now())

  property Property  @relation(fields: [propertyId], references: [id])
  payments Payment[]
}

model Payment {
  id         String   @id @default(cuid())
  propertyId Int
  tenantId   String
  amount     Float
  paidAt     DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  propertyId  Int
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
}

model DocumentRequirement {
  id            String   @id @default(cuid())
  applicationId String
  type          String // id, paystub, w2, bank_statement, tax_return, etc.
  label         String
  required      Boolean
  reason        String?
  satisfied     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
}

model LoanOfficer {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model PricingAuditLog {
  id        String   @id @default(cuid())
  actorRole String
  actorId   String?
  action    String
  module    String
  details   String
  createdAt DateTime @default(now())
}

model ServicingRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])

  status           String    @default("ACTIVE")
  nextPaymentDue   DateTime?
  escrowBalance    Float?    @default(0)
  delinquencyDays  Int?      @default(0)
  performanceScore Float?    @default(0)

  // Relations
  events      LoanServicingEvent[]
  riskSignals ServicingRiskSignal?
  eventScore  ServicingEventScore?
}

model Task {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowerId String?
  borrower   Borrower? @relation(fields: [borrowerId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?
  ipAddress    String?
  revoked      Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])
}

model UnderwritingAudit {
  id            String   @id @default(uuid())
  applicationId String
  adminId       String
  action        String
  notes         String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}
