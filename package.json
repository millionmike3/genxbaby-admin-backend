{
  "name": "genxbaby-admin-backend",
  "version": "1.0.0",
  "description": "Admin backend for GenXBaby OS — underwriting, audit logs, pipeline intelligence.",
  "main": "dist/index.js",
  "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
